{
  "name": "gityo",
  "version": "1.0.10",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NazmusSayad/gityo.git"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit && eslint .",
    "fix": "tsc --noEmit && eslint . --fix",
    "start": "tsx --watch ./src/index.ts",
    "build": "tsdown --config ./tsdown.config.ts",
    "dev": "concurrently --names \"R,T\" --prefix-colors \"blue.dim,magenta.dim\" \"tsdown --config ./tsdown.config.ts --watch\" \"tsc --noEmit --watch\"",
    "dev:tsc": "tsc --noEmit --watch",
    "json": "tsx ./src/json.ts"
  },
  "bin": {
    "gityo": "dist/index.js"
  },
  "devDependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.40",
    "@ai-sdk/anthropic": "^4.0.27",
    "@ai-sdk/azure": "^4.0.28",
    "@ai-sdk/cerebras": "^3.0.20",
    "@ai-sdk/cohere": "^4.0.18",
    "@ai-sdk/deepinfra": "^3.0.20",
    "@ai-sdk/deepseek": "^3.0.19",
    "@ai-sdk/fal": "^3.0.19",
    "@ai-sdk/fireworks": "^3.0.21",
    "@ai-sdk/google": "^4.0.31",
    "@ai-sdk/google-vertex": "^5.0.38",
    "@ai-sdk/groq": "^4.0.19",
    "@ai-sdk/luma": "^3.0.19",
    "@ai-sdk/mistral": "^4.0.20",
    "@ai-sdk/openai": "^4.0.27",
    "@ai-sdk/openai-compatible": "^3.0.20",
    "@ai-sdk/perplexity": "^4.0.20",
    "@ai-sdk/togetherai": "^3.0.21",
    "@ai-sdk/xai": "^4.0.25",
    "@aihubmix/ai-sdk-provider": "^2.2.1",
    "@commander-js/extra-typings": "^15.0.0",
    "@eslint/compat": "^1.4.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@friendliai/ai-provider": "^1.1.22",
    "@helicone/ai-sdk-provider": "^1.0.12",
    "@inquirer/core": "^11.1.5",
    "@inquirer/prompts": "^8.3.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "ai": "^7.0.47",
    "ai-gateway-provider": "^4.0.0",
    "ai-sdk-ollama": "^4.1.0",
    "ai-sdk-provider-opencode-sdk": "^3.0.6",
    "chalk": "^5.6.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "ollama-ai-provider-v2": "^4.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "pretty-ms": "^9.3.0",
    "rolldown": "1.0.0-rc.9",
    "sambanova-ai-provider": "^1.2.2",
    "simple-git": "^3.36.0",
    "tsdown": "^0.15.9",
